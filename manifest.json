
{
  "manifest_version": 3,
  "name": "Cookie Auditor Pro",
  "version": "3.0.0",
  "description": "Local cookie inventory for all websites",
  "minimum_chrome_version": "102",

  "permissions": [
    "cookies",
    "storage"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Auditor Pro"
  },

  "options_page": "options.html"
}

